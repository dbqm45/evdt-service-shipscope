{
  "name": "evdt-service-shipscope",
  "version": "0.2.16",
  "private": true,
  "description": "ShipScope — no dependencies; this file exposes `npm test` and the release scripts (RELEASING.md).",
  "scripts": {
    "dev": "node server/scripts/dev.js",
    "dev:mock": "node server/scripts/dev.js --mock",
    "test": "node --test \"test/*.test.js\"",
    "release": "node scripts/release.js",
    "lint:commit": "node scripts/check-commit-message.js",
    "hooks:install": "git config core.hooksPath .githooks"
  }
}
