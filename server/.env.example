# Copy to server/.env (gitignored) and fill in. `npm run dev` loads it; Render reads the same names
# from its own environment settings. Never commit server/.env.

# Postgres. DATABASE_SSL=false only for a local Postgres without TLS (see README); omit it on Render.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
DATABASE_SSL=false

# GitHub App (Settings -> Developer settings -> GitHub Apps). Client ID and a generated client secret.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# GitHub App server-to-server credentials (connecting repos, FR-004). Optional as a group: leave all three
# empty to run sign-in only. The private key is the .pem GitHub generates; "\n"-escaped newlines also work.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# Atlassian OAuth 2.0 (3LO) app for connecting Jira (FR-007; developer.atlassian.com/console/myapps), plus the key
# that encrypts stored Jira tokens: 32 random bytes, base64 (openssl rand -base64 32). Optional as a group.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Worker: minutes between deployment sync passes (1-1440, default 15).
# SYNC_INTERVAL_MINUTES=15

# Where this server is reachable from the browser. Must match the GitHub App's callback URL origin;
# https turns on Secure cookies. The worker reads it too: with a public https URL it registers Jira webhooks there
# (local http: Jira only syncs periodically).
PUBLIC_BASE_URL=http://localhost:3000

# Optional: the GitHub App's webhook secret (App settings -> Webhook, at least 20 characters), so deployments
# arrive within a minute. Needs a public URL GitHub can reach; leave unset locally.
# GITHUB_APP_WEBHOOK_SECRET=
